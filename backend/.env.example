# SQLite local. Para PostgreSQL cambia el provider en prisma/schema.prisma
# y usa algo como: postgresql://usuario:password@localhost:5432/cronograma
DATABASE_URL="file:./dev.db"

# Cambia esto en producción
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"

PORT=4000
NODE_ENV=development

# Usuario inicial creado por `npm run seed`
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@local"
ADMIN_PASSWORD="admin123"
